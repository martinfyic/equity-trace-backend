# Copiá este archivo a .env y completá los valores. Nunca subas .env a git.

# SQLite para desarrollo local; PostgreSQL en producción
# (postgres://... y postgresql://... también se aceptan).
DATABASE_URL=sqlite:///./portfolio.db

# Usuario único de la app
APP_USERNAME=admin
# Generalo con: python -m app.scripts.hash_password
# Dejalo entre comillas simples (el hash contiene símbolos "$").
APP_PASSWORD_HASH='pegá-acá-el-hash'

# Mínimo 32 caracteres. Generalo con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# Duración de la sesión (minutos). 1440 = 24 horas.
ACCESS_TOKEN_MINUTES=1440

# Dominios del frontend permitidos, separados por coma.
CORS_ORIGINS=http://localhost:3000
